{
  "name": "imagesitter",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test:format": "node scripts/check-project-format.mjs",
    "check": "pnpm test:format && vue-tsc --noEmit",
    "preview": "vite preview",
    "icon": "node scripts/generate-icon.mjs && tauri icon scripts/icon-source.png && node scripts/prune-icons.mjs",
    "tauri": "tauri",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^3.0.2",
    "reka-ui": "^2.3.0",
    "tailwind-merge": "^3.3.0",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
